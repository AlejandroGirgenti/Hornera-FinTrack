# Copiá este archivo como .env y ajustá los valores
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Base de datos (la que levanta docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fintrack

# Generá uno propio, por ejemplo con: openssl rand -base64 48
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Origen(es) del frontend permitidos por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173
